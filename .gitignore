# 인증키 — 절대 올리지 않는다. .env.example 만 올린다.
.env
*.env
!.env.example

# 분석 결과 — 주소만 있으면 다시 만들 수 있다. 대상지 하나에 10~50MB.
out/

# 서울시 수치지형도 캐시 (75MB). 처음 지형을 쓸 때 자동으로 다시 받는다.
cache/

# 첫 실행 시 패키지 설치 완료 표시 (PC마다 다름)
.setup_done

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
pytest-cache-files-*/
tmp*/

# 프런트엔드 빌드 의존성
node_modules/

# 윈도우·에디터
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# 임시
*.tmp
*.log

# 실행에 필요하지 않은 원문 참고자료는 배포 저장소에 넣지 않는다.
데이터활용시 참고자료/
연속수치지형도 데이터 설명서*.pdf
