# 이 파일을 같은 폴더에 `.env` 라는 이름으로 복사한 뒤 값을 채우세요.
# (.env 는 인증키가 들어있으니 외부 공유·업로드 금지)

# ── 브이월드 (vworld.kr) — 지적도·건물·도로·용도지역·지오코딩
VWORLD_KEY=여기에_브이월드_인증키
VWORLD_DOMAIN=http://localhost

# ── 공공데이터포털 (data.go.kr) — 건축물대장 (구조·용도·사용승인일)
# ※ 포털이 주는 두 가지 키 중 반드시 "일반 인증키(Decoding)" 를 넣으세요.
DATA_GO_KR_KEY=여기에_공공데이터포털_서비스키

# Google Gemini 이미지 렌더링 — Google AI Studio에서 발급한 API 키
GEMINI_API_KEY=여기에_Google_Gemini_API키
# 기본값: Nano Banana 2. 최고 품질이 필요하면 gemini-3-pro-image로 바꿀 수 있습니다.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# 건축물대장 엔드포인트가 바뀌면 여기서 교체 (기본값: 건축HUB)
# LEDGER_ENDPOINT=https://apis.data.go.kr/1613000/BldRgstHubService/getBrTitleInfo
